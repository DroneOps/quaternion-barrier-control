# CompilerName=gcc
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/glnxa64
matlabdir = /usr/local/MATLAB/R2023b
startdir = /home/paco/Research/Quadrotor_State_Restricted_Control/quaternion-barrier-control

# Toolchain information
cc = /usr/bin/gcc
cxx = g++
linker = /usr/bin/gcc
linkerxx = g++

cflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -std=c99 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DMODEL=restricted_drone_control_big_trajectory_change_func_mex -msse2 -c 

cxxflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -std=c++11 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DMODEL=restricted_drone_control_big_trajectory_change_func_mex -msse2 -c 

ldflags =  -pthread -Wl,--no-undefined -Wl,-rpath-link,$matlabdir/bin/glnxa64 -shared  -L"$matlabdir/bin/glnxa64" -lmx -lmex -lmat -lm -lstdc++  -Wl,-Bsymbolic -o restricted_drone_control_big_trajectory_change_func_mex.mexa64 -L"$matlabdir/bin/glnxa64" -lmwblas -lemlrt -lcovrt -lut -lmwmathutil  -Wl,--version-script,restricted_drone_control_big_trajectory_change_func_mex.map

linkobjs = 

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker $in $linkobjs $ldflags

rule linkxx
    command = $linkerxx $in $linkobjs $ldflags

# Build
build $builddir/restricted_drone_control_big_trajectory_change_func_data.o : cc $root/restricted_drone_control_big_trajectory_change_func_data.c
build $builddir/rt_nonfinite.o : cc $root/rt_nonfinite.c
build $builddir/restricted_drone_control_big_trajectory_change_func_initialize.o : cc $root/restricted_drone_control_big_trajectory_change_func_initialize.c
build $builddir/restricted_drone_control_big_trajectory_change_func_terminate.o : cc $root/restricted_drone_control_big_trajectory_change_func_terminate.c
build $builddir/restricted_drone_control_big_trajectory_change_func.o : cc $root/restricted_drone_control_big_trajectory_change_func.c
build $builddir/rotvec.o : cc $root/rotvec.c
build $builddir/sumMatrixIncludeNaN.o : cc $root/sumMatrixIncludeNaN.c
build $builddir/mldivide.o : cc $root/mldivide.c
build $builddir/warning.o : cc $root/warning.c
build $builddir/_coder_restricted_drone_control_big_trajectory_change_func_api.o : cc $root/interface/_coder_restricted_drone_control_big_trajectory_change_func_api.c
build $builddir/_coder_restricted_drone_control_big_trajectory_change_func_mex.o : cc $root/interface/_coder_restricted_drone_control_big_trajectory_change_func_mex.c
build $builddir/normalize.o : cc $root/normalize.c
build $builddir/log.o : cc $root/log.c
build $builddir/exp.o : cc $root/exp.c
build $builddir/div.o : cc $root/div.c
build $builddir/_coder_restricted_drone_control_big_trajectory_change_func_info.o : cc $root/interface/_coder_restricted_drone_control_big_trajectory_change_func_info.c
build $builddir/c_mexapi_version.o : cc $matlabdir/extern/version/c_mexapi_version.c

# Link
build $root/restricted_drone_control_big_trajectory_change_func_mex.mexa64 : link $builddir/restricted_drone_control_big_trajectory_change_func_data.o $builddir/rt_nonfinite.o $builddir/restricted_drone_control_big_trajectory_change_func_initialize.o $builddir/restricted_drone_control_big_trajectory_change_func_terminate.o $builddir/restricted_drone_control_big_trajectory_change_func.o $builddir/rotvec.o $builddir/sumMatrixIncludeNaN.o $builddir/mldivide.o $builddir/warning.o $builddir/_coder_restricted_drone_control_big_trajectory_change_func_api.o $builddir/_coder_restricted_drone_control_big_trajectory_change_func_mex.o $builddir/normalize.o $builddir/log.o $builddir/exp.o $builddir/div.o $builddir/_coder_restricted_drone_control_big_trajectory_change_func_info.o $builddir/c_mexapi_version.o 
